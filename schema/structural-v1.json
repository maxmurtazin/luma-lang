{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxmurtazin.github.io/luma-lang/schema/structural-v1.json",
  "title": "Luma Structural Core S1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producer",
    "valid",
    "files",
    "syntax",
    "nodes",
    "edges",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "producer": {
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceFile"
      }
    },
    "syntax": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SyntaxNode"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SemanticNode"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Edge"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    }
  },
  "$defs": {
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "start",
        "end"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "SourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "Type": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "bool"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unit"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unresolved"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "element"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "element": {
              "$ref": "#/$defs/Type"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parameters",
            "result"
          ],
          "properties": {
            "kind": {
              "const": "function"
            },
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Type"
              }
            },
            "result": {
              "$ref": "#/$defs/Type"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "namespace"
            },
            "target": {
              "type": "string"
            }
          }
        }
      ]
    },
    "SyntaxNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "parent",
        "location",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "name",
            "number",
            "string",
            "bool",
            "unary",
            "binary",
            "pipeline",
            "array",
            "group",
            "call",
            "index",
            "member",
            "assign",
            "return",
            "function",
            "object",
            "use",
            "public",
            "match",
            "arm",
            "wildcard"
          ]
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SemanticNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "syntax",
        "location",
        "ty",
        "public",
        "effect"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "definition",
            "reference",
            "expression",
            "pattern",
            "module",
            "builtin"
          ]
        },
        "syntax": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "ty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Type"
            },
            {
              "type": "null"
            }
          ]
        },
        "public": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect": {
          "anyOf": [
            {
              "enum": [
                "not_flagged",
                "conservative_effectful"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "contains",
            "reads",
            "resolves_to",
            "calls",
            "callback",
            "imports",
            "captures"
          ]
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "location"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
      }
    }
  }
}
