{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luma-lang/spec/cad/core-state-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "instance_id",
    "part_id",
    "accepted_source",
    "identity_registry",
    "external_pins",
    "overrides",
    "public_outputs"
  ],
  "properties": {
    "schema": {
      "enum": [
        "luma.cad.recipe-instance-state/1"
      ]
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "part_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "accepted_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "artifact_id"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        }
      }
    },
    "identity_registry": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "type",
          "state"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "live",
              "tombstone"
            ]
          }
        }
      }
    },
    "external_pins": {
      "type": "array",
      "items": {
        "$ref": "https://luma-lang/spec/cad/wire-v1.json#/$defs/PinnedRef"
      }
    },
    "overrides": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "Quantity"
                ]
              },
              "value": {
                "$ref": "https://luma-lang/spec/cad/wire-v1.json#/$defs/Quantity"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "Count"
                ]
              },
              "value": {
                "$ref": "https://luma-lang/spec/cad/wire-v1.json#/$defs/U64"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "Boolean"
                ]
              },
              "value": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "Scalar"
                ]
              },
              "value": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
              }
            }
          }
        ]
      }
    },
    "public_outputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "https://luma-lang/spec/cad/wire-v1.json#/$defs/PinnedRef"
      }
    }
  },
  "$defs": {}
}
