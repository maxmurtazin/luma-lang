{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luma-lang/spec/cad/lock-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "profile",
    "language",
    "contract",
    "numeric_profiles",
    "providers",
    "adapters",
    "targets"
  ],
  "properties": {
    "protocol": {
      "enum": [
        "luma.cad.lock/1"
      ]
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "profile": {
      "enum": [
        "cad0-bootstrap"
      ]
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit",
        "structural_schema"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "structural_schema": {
          "enum": [
            1
          ]
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wire_schema",
        "descriptor_schema",
        "canonical_encoding",
        "inputs"
      ],
      "properties": {
        "wire_schema": {
          "enum": [
            1
          ]
        },
        "descriptor_schema": {
          "enum": [
            1
          ]
        },
        "canonical_encoding": {
          "enum": [
            "LCAN/1"
          ]
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:\\x00-\\x1f]+(?:/[^/\\\\:\\x00-\\x1f]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "numeric_profiles": {
      "type": "array",
      "items": {
        "enum": [
          "si-f64-v1"
        ]
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "commit",
          "selection",
          "review_paths"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^https://github[.]com/maxmurtazin/[a-z0-9-]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "selection": {
            "enum": [
              "selected",
              "inventory"
            ]
          },
          "review_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:\\x00-\\x1f]+(?:/[^/\\\\:\\x00-\\x1f]+)*$"
            }
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:\\x00-\\x1f]+(?:/[^/\\\\:\\x00-\\x1f]+)*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "build_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "toolchain": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minProperties": 1
    },
    "adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "version",
          "path",
          "compatible_with",
          "inputs",
          "build_fingerprint"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:\\x00-\\x1f]+(?:/[^/\\\\:\\x00-\\x1f]+)*$"
          },
          "compatible_with": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"
            }
          },
          "inputs": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:\\x00-\\x1f]+(?:/[^/\\\\:\\x00-\\x1f]+)*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "build_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "providers",
          "bootstrap",
          "luma_integration"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:/-]{0,127}$"
            }
          },
          "bootstrap": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "luma_integration": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          }
        }
      }
    }
  },
  "$defs": {}
}
